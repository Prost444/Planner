# ---- Claude (обязательно для работы агента) --------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Модель и «усилие» (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# Серверный fallback при срабатывании защитных классификаторов (beta). Выключите, если API отвечает 400 на fallbacks.
ANTHROPIC_SERVER_SIDE_FALLBACK=true
# Встроенный веб-поиск Claude (web_search / web_fetch) — основной способ искать на Ozon/Я.Маркет/Авито без своих ключей
AGENT_WEB_SEARCH=true
AGENT_WEB_SEARCH_MAX_USES=8
AGENT_WEB_FETCH_MAX_USES=6
# Ограничить веб-поиск доменами (через запятую). Пусто = без ограничений.
WEB_SEARCH_ALLOWED_DOMAINS=

# ---- Генерация рендеров (одно из двух; без ключей возвращается снимок 3D) ----
# OpenAI gpt-image-1 (image edits с несколькими входными картинками)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# Google Gemini (Nano Banana)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image
# Принудительный выбор провайдера: openai | gemini | mock
IMAGE_PROVIDER=

# ---- Дополнительные поисковые провайдеры (необязательно) --------------------
# Tavily (поиск с ограничением по доменам маркетплейсов)
TAVILY_API_KEY=
# SerpAPI (Google) — альтернатива Tavily
SERPAPI_API_KEY=
# Прямой API Wildberries (без ключа; может быть недоступен из-за антибота)
SEARCH_WILDBERRIES=true

# ---- Сервер ----------------------------------------------------------------
PORT=8787
# Где хранить проекты и загрузки (по умолчанию apps/server/data)
# DATA_DIR=/var/lib/planner
